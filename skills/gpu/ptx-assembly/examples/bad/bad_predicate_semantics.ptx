// BAD: inverted guard predicate polarity.
// Intent: only threads with %n > 0 add %n to %r.
// %pgt = (%n > 0), so "@%pgt bra $skip" skips the add for the very
// threads that should execute it - the body runs only when %n <= 0.

.version 8.0
.target sm_80
.address_size 64

.entry bad_predicate_semantics
(
    .param .u64 gbl_out
)
{
    .reg .u32  %r, %n;
    .reg .u64  %p;
    .reg .pred %pgt;

    ld.param.u64 %p, [gbl_out];
    mov.u32 %r, 0;
    mov.u32 %n, %tid.x;

    setp.gt.s32 %pgt, %n, 0;          // %pgt = (%n > 0)
    @%pgt bra $skip;                  // BUG: should be @!%pgt
    add.s32 %r, %r, %n;               // executed only when %n <= 0
$skip:
    st.global.u32 [%p], %r;
    ret;
}
