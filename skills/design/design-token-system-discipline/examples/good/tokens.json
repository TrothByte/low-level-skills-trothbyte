{
  "color": {
    "brand": {
      "50":  {"$type": "color", "$value": "#F5F7FF"},
      "500": {"$type": "color", "$value": "#4F46E5"},
      "900": {"$type": "color", "$value": "#1E1B4B"}
    },
    "neutral": {
      "100": {"$type": "color", "$value": "#F9FAFB"},
      "700": {"$type": "color", "$value": "#374151"},
      "900": {"$type": "color", "$value": "#111827"}
    }
  },
  "spacing": {
    "xs": {"$type": "dimension", "$value": "4px"},
    "sm": {"$type": "dimension", "$value": "8px"},
    "md": {"$type": "dimension", "$value": "16px"},
    "lg": {"$type": "dimension", "$value": "24px"},
    "xl": {"$type": "dimension", "$value": "48px"}
  },
  "font": {
    "family": {
      "sans": {"$type": "fontFamily", "$value": "Spline Sans, sans-serif"}
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": "24px"
      }
    }
  },
  "semantic": {
    "color": {
      "text": {
        "primary": {"$type": "color", "$value": "{color.neutral.900}"},
        "muted":   {"$type": "color", "$value": "{color.neutral.700}"}
      },
      "background": {"$type": "color", "$value": "{color.neutral.100}"},
      "action":     {"$type": "color", "$value": "{color.brand.500}"}
    },
    "space": {
      "sm":     {"$type": "dimension", "$value": "{spacing.sm}"},
      "md":     {"$type": "dimension", "$value": "{spacing.md}"},
      "card":   {"$type": "dimension", "$value": "{spacing.lg}"},
      "section": {"$type": "dimension", "$value": "{spacing.xl}"}
    }
  }
}
