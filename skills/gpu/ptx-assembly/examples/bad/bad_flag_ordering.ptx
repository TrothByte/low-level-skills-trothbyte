// BAD: cross-CTA flag protocol without acquire/release ordering.
// Plain ld/st default to .weak: no synchronization, no atomicity.
// The consumer may observe flag==1 before the data write is visible.

.version 8.0
.target sm_80
.address_size 64

.entry bad_flag_ordering
(
    .param .u64 gbl_data,
    .param .u64 gbl_flag
)
{
    .reg .u32  %val, %flag;
    .reg .u64  %p_data, %p_flag;
    .reg .pred %p;

    ld.param.u64 %p_data, [gbl_data];
    ld.param.u64 %p_flag, [gbl_flag];

    setp.eq.u32 %p, %ctaid.x, 0;
    @%p bra $producer;

    // Consumer (block != 0): spin on the flag.
$retry:
    // BUG: missing .acquire - the spin may never observe the release.
    ld.global.u32 %flag, [%p_flag];
    setp.ne.u32 %p, %flag, 1;
    @%p bra $retry;
    // BUG: no happens-before edge; this may still read the stale value.
    ld.global.u32 %val, [%p_data];
    bra $done;

$producer:
    setp.eq.u32 %p, %tid.x, 0;
    @!%p bra $done;
    mov.u32 %val, 42;
    // BUG: missing .release on both the data and the flag.
    st.global.u32 [%p_data], %val;
    st.global.u32 [%p_flag], 1;

$done:
    ret;
}
